  "grammar": [
    {
      "title": {
        "es": "Verbos en -AR",
        "en": "-AR Verbs",
        "ar": "الأفعال المنتهية بـ -AR"
      },
      "explanation": {
        "es": "Verbos en -ar (hablar): yo hablo, tú hablas, él/ella habla, nosotros hablamos, ustedes hablan, ellos/ellas hablan. La terminación cambia: -o, -as, -a, -amos, -áis, -an.",
        "en": "-ar verbs (falar - to speak): eu falo (I speak), você fala (you speak), ele/ela fala (he/she speaks), nós falamos (we speak), vocês falam (you pl. speak), eles/elas falam (they speak). The ending changes: -o, -a, -a, -amos, -am, -am.",
        "ar": "الأفعال المنتهية بـ -ar (falar - يتكلم): eu falo (أتحدث)، você fala (تتحدث)، ele/ela fala (هو/هي يتحدث)، nós falamos (نتحدث)، vocês falam (تتحدثون)، eles/elas falam (يتحدثون). تتغير النهاية: -o، -a، -a، -amos، -am، -am."
      },
      "examples": [
        {
          "es": "Yo hablo español.",
          "en": "I speak Portuguese.",
          "ar": "أتحدث البرتغالية."
        },
        {
          "es": "Nosotros trabajamos mucho.",
          "en": "We work a lot.",
          "ar": "نحن نعمل كثيرًا."
        },
        {
          "es": "Usted estudia todos los días.",
          "en": "You study every day.",
          "ar": "أنت تدرس كل يوم."
        }
      ]
    },
    {
      "title": {
        "es": "Verbos en -ER e -IR",
        "en": "-ER and -IR Verbs",
        "ar": "الأفعال المنتهية بـ -ER و -IR"
      },
      "explanation": {
        "es": "-er (comer): yo como, tú comes, él come, nosotros comemos, ustedes comen. -ir (abrir): yo abro, tú abres, él abre, nosotros abrimos, ustedes abren. Excepciones comunes: 'tener' y 'venir'.",
        "en": "-er (comer - to eat): eu como (I eat), você come, ele come, nós comemos, vocês comem. -ir (abrir - to open): eu abro, você abre, ele abre, nós abrimos, vocês abrem. Common exceptions: 'ter' (to have) and 'vir' (to come).",
        "ar": "-er (comer - يأكل): eu como (آكل)، você come، ele come، nós comemos، vocês comem. -ir (abrir - يفتح): eu abro، você abre، ele abre، nós abrimos، vocês abrem. استثناءات شائعة: 'ter' (يملك) و 'vir' (يأتي)."
      },
      "examples": [
        {
          "es": "Yo como arroz y frijoles.",
          "en": "I eat rice and beans.",
          "ar": "آكل الأرز والفاصوليا."
        },
        {
          "es": "Ella aprende español rápido.",
          "en": "She learns Portuguese fast.",
          "ar": "تتعلم البرتغالية بسرعة."
        },
        {
          "es": "Nosotros vemos la tele por la noche.",
          "en": "We watch TV at night.",
          "ar": "نشاهد التلفاز في الليل."
        }
      ]
    }
  ],
  "dialogue": {
    "title": {
      "es": "La Rutina de Carla",
      "en": "Carla's Routine",
      "ar": "روتين كارلا"
    },
    "lines": [
      {
        "speaker": "Carla",
        "es": "Yo trabajo en Madrid y vivo en el centro.",
        "en": "I work in São Paulo and live downtown.",
        "ar": "أعمل في ساو باولو وأسكن في المركز."
      },
      {
        "speaker": "Amiga",
        "es": "¿Usted también estudia?",
        "en": "Do you also study?",
        "ar": "هل تدرسين أيضًا؟"
      },
      {
        "speaker": "Carla",
        "es": "Sí, aprendo inglés por la noche.",
        "en": "Yes, I learn Spanish at night.",
        "ar": "نعم، أتعلم الإسبانية في الليل."
      },
      {
        "speaker": "Amiga",
        "es": "¿Y qué come usted en el trabajo?",
        "en": "And what do you eat at work?",
        "ar": "وماذا تأكلين في العمل؟"
      },
      {
        "speaker": "Carla",
        "es": "Como un sándwich y bebo café. Es rápido.",
        "en": "I eat a sandwich and drink coffee. It's fast.",
        "ar": "آكل شطيرة وأشرب القهوة. إنه سريع."
      }
    ]
  },
  "reading": {
    "title": {
      "es": "El Día de Pedro",
      "en": "Pedro's Day",
      "ar": "يوم بيدرو"
    },
    "text_es": "Pedro vive en España. Trabaja en una empresa y viaja mucho. Todos los días abre el ordenador a las ocho. Escribe correos y habla con los clientes. Por la noche cena con la familia y ve la tele.",
    "text_en": "Pedro lives in Brazil. He works at a company and travels a lot. Every day he opens his computer at eight o'clock. He writes emails and talks with clients. At night, he eats with his family and watches TV.",
    "text_ar": "يعيش بيدرو في البرازيل. يعمل في شركة ويسافر كثيرًا. كل يوم يفتح جهاز الكمبيوتر في الساعة الثامنة. يكتب رسائل البريد ويتحدث مع العملاء. في الليل، يأكل مع عائلته ويشاهد التلفاز."
  },

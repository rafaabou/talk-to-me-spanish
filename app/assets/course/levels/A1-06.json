  "grammar": [
    {
      "title": {
        "es": "Verbos en -AR",
        "en": "-AR Verbs",
        "ar": "الأفعال المنتهية بـ -AR"
      },
      "explanation": {
        "es": "Verbos en -ar (hablar): yo hablo, tú hablas, él/ella habla, nosotros hablamos, ustedes hablan, ellos/ellas hablan. La terminación cambia: -o, -as, -a, -amos, -áis, -an.",
        "en": "-ar verbs (hablar - to speak): yo hablo (I speak), tú hablas (you speak), él/ella habla (he/she speaks), nosotros hablamos (we speak), ustedes hablan (you pl. speak), ellos/ellas hablan (they speak). The ending changes: -o, -as, -a, -amos, -áis, -an.",
        "ar": "الأفعال المنتهية بـ -ar (hablar - يتكلم): yo hablo (أتحدث)، tú hablas (تتحدث)، él/ella habla (يتحدث)، nosotros hablamos (نتحدث)، ustedes hablan (تتحدثون)، ellos/ellas hablan (يتحدثون). تتغير النهاية: -o، -as، -a، -amos، -áis، -an."
      },
      "examples": [
        {
          "es": "Yo hablo español.",
          "en": "I speak Portuguese.",
          "ar": "أتحدث البرتغالية."
        },
        {
          "es": "Nosotros trabajamos mucho.",
          "en": "We work a lot.",
          "ar": "نحن نعمل كثيرًا."
        },
        {
          "es": "Usted estudia todos los días.",
          "en": "You study every day.",
          "ar": "أنت تدرس كل يوم."
        }
      ]
    },
    {
      "title": {
        "es": "Verbos en -ER e -IR",
        "en": "-ER and -IR Verbs",
        "ar": "الأفعال المنتهية بـ -ER و -IR"
      },
      "explanation": {
        "es": "-er (comer): yo como, tú comes, él come, nosotros comemos, ustedes comen. -ir (abrir): yo abro, tú abres, él abre, nosotros abrimos, ustedes abren. Excepciones comunes: 'tener' y 'venir'.",
        "en": "-er (comer): yo como, tú comes, él come, nosotros comemos, ustedes comen. -ir (abrir): yo abro, tú abres, él abre, nosotros abrimos, ustedes abren. Common exceptions: 'tener' and 'venir'.",
        "ar": "-er (comer - يأكل): yo como، tú comes، él come، nosotros comemos، ustedes comen. -ir (abrir - يفتح): yo abro، tú abres، él abre، nosotros abrimos، ustedes abren. استثناءات شائعة: 'tener' و 'venir'."
      },
      "examples": [
        {
          "es": "Yo como arroz y frijoles.",
          "en": "I eat rice and beans.",
          "ar": "آكل الأرز والفاصوليا."
        },
        {
          "es": "Ella aprende español rápido.",
          "en": "She learns Portuguese fast.",
          "ar": "تتعلم البرتغالية بسرعة."
        },
        {
          "es": "Nosotros vemos la tele por la noche.",
          "en": "We watch TV at night.",
          "ar": "نشاهد التلفاز في الليل."
        }
      ]
    }
  ],
  "dialogue": {
    "title": {
      "es": "La Rutina de Carla",
      "en": "Carla's Routine",
      "ar": "روتين كارلا"

  "grammar": [
    {
      "title": {
        "es": "Ser vs. Estar",
        "en": "Ser vs. Estar",
        "ar": "Ser مقابل Estar"
      },
      "explanation": {
        "es": "'Ser' se usa para características permanentes, identidad y origen: Yo soy español (I am Spanish). 'Estar' se usa para estados temporales, condiciones y ubicación: Yo estoy cansado (I am tired). Las dos palabras significan 'to be' pero se usan en contextos diferentes.",
        "en": "'Ser' is used for permanent characteristics, identity and origin: Yo soy español (I am Spanish). 'Estar' is used for temporary states, conditions and location: Yo estoy cansado (I am tired). Both words mean 'to be' but are used in different contexts.",
        "ar": "يُستخدم 'ser' للصفات الدائمة والهوية والأصل: yo soy español (أنا إسباني). ويُستخدم 'estar' للحالات المؤقتة والأحوال والمكان: yo estoy cansado (أنا متعب). كلتا الكلمتين تعني 'يكون' لكن تُستخدمان في سياقات مختلفة."
      },
      "examples": [
        {
          "es": "Yo soy profesor.",
          "en": "I am a teacher. (identity)",
          "ar": "أنا معلم. (هوية)"
        },
        {
          "es": "Yo estoy cansado.",
          "en": "I am tired. (temporary)",
          "ar": "أنا متعب. (مؤقت)"
        },
        {
          "es": "Ella es feliz.",
          "en": "She is happy. (characteristic)",
          "ar": "هي سعيدة. (صفة دائمة)"
        },
        {
          "es": "Él está enfermo.",
          "en": "He is sick. (temporary)",
          "ar": "هو مريض. (حالة مؤقتة)"
        }
      ]
    },
    {
      "title": {
        "es": "Conjugación de Ser y Estar",
        "en": "Conjugation of Ser and Estar",
        "ar": "تصريف Ser و Estar"
      },
      "explanation": {
        "es": "Ser: yo soy, tú eres, él/ella es, nosotros somos, ustedes son, ellos/ellas son. Estar: yo estoy, tú estás, él/ella está, nosotros estamos, ustedes están, ellos/ellas están. Observe que 'usted' usa la tercera persona.",
        "en": "Ser: yo soy, tú eres, él/ella es, nosotros somos, ustedes son, ellos/ellas son. Estar: yo estoy, tú estás, él/ella está, nosotros estamos, ustedes están, ellos/ellas están. Note that 'usted' takes third-person verb forms.",
        "ar": "Ser: yo soy، tú eres، él/ella es، nosotros somos، ustedes son، ellos/ellas son. Estar: yo estoy، tú estás، él/ella está، nosotros estamos، ustedes están، ellos/ellas están. لاحظ أن 'usted' تستخدم صيغة الغائب."
      },
      "examples": [
        {
          "es": "Nosotros somos estudiantes.",
          "en": "We are students.",
          "ar": "نحن طلاب."
        },
        {
          "es": "Ellos están en la escuela ahora.",
          "en": "They are at school now.",
          "ar": "هم في المدرسة الآن."
        },
        {
          "es": "Usted es muy inteligente.",
          "en": "You are very intelligent.",
          "ar": "أنت ذكي جدًا."
        }
      ]
    }
  ],

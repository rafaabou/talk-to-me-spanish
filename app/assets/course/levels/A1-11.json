  "grammar": [
    {
      "title": {
        "es": "Diciendo la Hora",
        "en": "Telling Time",
        "ar": "قول الوقت"
      },
      "explanation": {
        "es": "Para la hora exacta: 'Es la una' (1:00), 'Son las dos' (2:00). Para los minutos: 'Son las tres y cuarto' (3:15), 'Son las cuatro y media' (4:30), 'Son las seis menos cinco' (5:55). 'Media' = 30 min.",
        "en": "For the exact hour: 'É uma hora' (1:00), 'São duas horas' (2:00). For minutes: 'São três e quinze' (3:15), 'São quatro e meia' (4:30), 'São cinco para as seis' (5:55). 'Meia' = 30 minutes.",
        "ar": "للساعة الصحيحة: 'É uma hora' (الساعة الواحدة)، 'São duas horas' (الساعة الثانية). للدقائق: 'São três e quinze' (3:15)، 'São quatro e meia' (4:30)، 'São cinco para as seis' (5:55). 'meia' = 30 دقيقة."
      },
      "examples": [
        {
          "es": "¿Qué hora es? Son las ocho.",
          "en": "What time is it? It's eight o'clock.",
          "ar": "كم الساعة؟ إنها الثامنة."
        },
        {
          "es": "Es la una de la tarde.",
          "en": "It's one in the afternoon.",
          "ar": "إنها الواحدة ظهرًا."
        },
        {
          "es": "Son las nueve menos diez.",
          "en": "It's ten to nine.",
          "ar": "إنها العاشرة إلى التاسعة."
        }
      ]
    },
    {
      "title": {
        "es": "Rutina Diaria",
        "en": "Daily Routine",
        "ar": "الروتين اليومي"
      },
      "explanation": {
        "es": "Para describir la rutina: 'Me despierto a las siete' (I wake up at seven). 'A las' = at (time). 'Por la mañana' (in the morning), 'por la tarde' (in the afternoon), 'por la noche' (at night). Ejemplo: 'Por la mañana, desayuno y salgo al trabajo.'",
        "en": "To describe routine: 'Eu acordo às sete horas' (I wake up at seven). 'Às' = at (time). 'De manhã' (in the morning), 'à tarde' (in the afternoon), 'à noite' (at night). Example: 'De manhã, eu tomo café e saio para o trabalho.' (In the morning, I have breakfast and leave for work.)",
        "ar": "لوصف الروتين: 'Eu acordo às sete horas' (أستيقظ في السابعة). 'às' = في (للوقت). 'de manhã' (في الصباح)، 'à tarde' (في الظهيرة)، 'à noite' (في الليل). مثال: 'De manhã, eu tomo café e saio para o trabalho.' (في الصباح، أتناول الفطور وأخرج إلى العمل.)"
      },
      "examples": [
        {
          "es": "Me despierto a las seis y media.",
          "en": "I wake up at six thirty.",
          "ar": "أستيقظ في السادسة والنصف."
        },
        {
          "es": "Por la noche, veo la tele.",
          "en": "At night, I watch TV.",
          "ar": "في الليل، أشاهد التلفاز."
        },
        {
          "es": "Llego a casa por la tarde.",
          "en": "I arrive home in the afternoon.",
          "ar": "أصل إلى المنزل في الظهيرة."
        }
      ]
    }
  ],
  "dialogue": {
    "title": {
      "es": "La Rutina de Bruno",
      "en": "Bruno's Routine",
      "ar": "روتين برونو"
    },
    "lines": [
      {
        "speaker": "Amiga",
        "es": "Bruno, ¿a qué hora te despiertas?",
        "en": "Bruno, what time do you wake up?",
        "ar": "برونو، في أي ساعة تستيقظ؟"
      },
      {
        "speaker": "Bruno",
        "es": "Me despierto a las seis y media de la mañana.",
        "en": "I wake up at six thirty in the morning.",
        "ar": "أستيقظ في السادسة والنصف صباحًا."
      },
      {
        "speaker": "Amiga",
        "es": "¿Y qué haces después?",
        "en": "And what do you do after?",
        "ar": "وماذا تفعل بعد ذلك؟"
      },
      {
        "speaker": "Bruno",
        "es": "Me ducho, desayuno y salgo a las ocho.",
        "en": "I shower, have breakfast and leave at eight.",
        "ar": "أستحم، أتناول الفطور وأخرج في الثامنة."
      },
      {
        "speaker": "Amiga",
        "es": "¿A qué hora llegas a casa?",
        "en": "What time do you arrive home?",
        "ar": "في أي ساعة تصل إلى المنزل؟"
      },
      {
        "speaker": "Bruno",
        "es": "A las seis de la tarde. Después duermo temprano.",
        "en": "At six in the evening. Then I sleep early.",
        "ar": "في السادسة مساءً. ثم أنام مبكرًا."
      }
    ]
  },
  "reading": {
    "title": {
      "es": "Un Día en la Vida de Luisa",
      "en": "A Day in the Life of Luiza",
      "ar": "يوم من حياة لويزا"
    },
    "text_es": "Luisa se despierta a las siete. Por la mañana desayuna café con pan y sale al trabajo a las ocho y media. Al mediodía almuerza cerca de la oficina. Por la tarde vuelve a casa. Por la noche cena con la familia y duerme a las once.",
    "text_en": "Luiza wakes up at seven. In the morning, she has coffee with bread and leaves for work at eight thirty. At noon, she has lunch near the office. In the afternoon, she returns home. At night, she has dinner with her family and sleeps at eleven.",
    "text_ar": "تستيقظ لويزا في السابعة. في الصباح، تتناول القهوة مع الخبز وتخرج إلى العمل في الثامنة والنصف. عند الظهيرة، تتناول الغداء قرب المكتب. في الظهيرة، تعود إلى المنزل. في الليل، تتناول العشاء مع عائلتها وتنام في الحادية عشرة."
  },

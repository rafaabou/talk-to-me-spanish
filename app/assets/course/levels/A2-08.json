  "grammar": [
    {
      "title": {
        "es": "Expresiones de Salud con Estar y Sentirse",
        "en": "Health Expressions with Estar and Sentir",
        "ar": "تعبيرات الصحة مع estar و sentir"
      },
      "explanation": {
        "es": "Para hablar de salud: 'Estoy enfermo' (I am sick), 'Estoy con dolor de cabeza' (I have a headache), 'Estoy con fiebre' (I have a fever), 'Me siento cansado' (I feel tired), 'Estoy con gripe' (I have the flu). El dolor es localizado: dolor de cabeza, dolor de estómago, dolor de garganta.",
        "en": "To talk about health: 'Estoy enfermo' (I am sick), 'Estoy con dolor de cabeza' (I have a headache), 'Estoy con fiebre' (I have a fever), 'Me siento cansado' (I feel tired), 'Estoy con gripe' (I have the flu). Pain is localized: dolor de cabeza (headache), dolor de estómago (stomachache), dolor de garganta (sore throat).",
        "ar": "للتحدث عن الصحة: 'Estoy enfermo' (أنا مريض)، 'Estoy con dolor de cabeza' (عندي صداع)، 'Estoy con fiebre' (عندي حمى)، 'Me siento cansado' (أشعر بالتعب)، 'Estoy con gripe' (عندي إنفلونزا). موضع الألم محدد: dolor de cabeza (صداع)، dolor de estómago (ألم بطن)، dolor de garganta (التهاب حلق)."
      },
      "examples": [
        {
          "es": "Estoy con dolor de garganta.",
          "en": "I have a sore throat.",
          "ar": "أعاني من التهاب في الحلق."
        },
        {
          "es": "Ella está con fiebre desde ayer.",
          "en": "She has had a fever since yesterday.",
          "ar": "إنها تعاني من الحمى منذ الأمس."
        },
        {
          "es": "Me siento mejor hoy.",
          "en": "I feel better today.",
          "ar": "أشعر بتحسن اليوم."
        }
      ]
    },
    {
      "title": {
        "es": "Tener que / Deber (Obligación y Consejo)",
        "en": "Ter que / Dever (Obligation and Advice)",
        "ar": "ter que / dever (الواجب والنصيحة)"
      },
      "explanation": {
        "es": "Para la obligación: 'tener que + infinitivo': 'Tengo que descansar' (I have to rest). Para el consejo: 'deber + infinitivo': 'Debes beber mucha agua' (You should drink a lot of water), 'Debes ir al médico' (You should go to the doctor).",
        "en": "For obligation: 'tener que + infinitive': 'Tengo que descansar' (I have to rest). For advice: 'deber + infinitive': 'Debes beber mucha agua' (You should drink a lot of water), 'Debes ir al médico' (You should go to the doctor).",
        "ar": "للإلزام: 'tener que + المصدر': 'Tengo que descansar' (يجب أن أرتاح). للنصيحة: 'deber + المصدر': 'Debes beber mucha agua' (يجب أن تشرب ماءً كثيرًا)، 'Debes ir al médico' (يجب أن تذهب إلى الطبيب)."
      },
      "examples": [
        {
          "es": "Tienes que tomar el medicamento.",
          "en": "You have to take the medicine.",
          "ar": "يجب أن تتناول الدواء."
        },
        {
          "es": "Ella debe descansar dos días.",
          "en": "She should rest for two days.",
          "ar": "يجب أن تستريح لمدة يومين."
        },
        {
          "es": "Necesito pedir una cita.",
          "en": "I need to book an appointment.",
          "ar": "أحتاج إلى تحديد موعد طبي."
        }
      ]
    }
  ],
  "dialogue": {
    "title": {
      "es": "En el Consultorio",
      "en": "At the Doctor's Office",
      "ar": "في عيادة الطبيب"
    },
    "lines": [
      {
        "speaker": "Médico",
        "es": "¡Buenos días! ¿Qué sientes?",
        "en": "Good morning! What are you feeling?",
        "ar": "صباح الخير! بماذا تشعر؟"
      },
      {
        "speaker": "Paciente",
        "es": "Estoy con dolor de garganta y fiebre.",
        "en": "I have a sore throat and a fever.",
        "ar": "أعاني من التهاب في الحلق وحمى."
      },
      {
        "speaker": "Médico",
        "es": "¿Desde cuándo?",
        "en": "Since when?",
        "ar": "منذ متى؟"
      },
      {
        "speaker": "Paciente",
        "es": "Desde ayer por la noche.",
        "en": "Since last night.",
        "ar": "منذ الليلة الماضية."
      },
      {
        "speaker": "Médico",
        "es": "Tienes que tomar este medicamento y descansar.",
        "en": "You have to take this medicine and rest.",
        "ar": "يجب أن تتناول هذا الدواء وتستريح."
      },
      {
        "speaker": "Paciente",
        "es": "Gracias, doctor. Sigo las instrucciones.",
        "en": "Thank you, doctor. I will follow the instructions.",
        "ar": "شكرًا يا دكتور. سأتبع التعليمات."
      }
    ]
  },
  "reading": {
    "title": {
      "es": "El Resfriado de Carlos",
      "en": "Carlos's Cold",
      "ar": "زكام كارلوس"
    },
    "text_es": "Carlos se despertó con dolor de cabeza y dolor de garganta. Está con fiebre, así que fue al médico. El médico le recetó un medicamento y le dijo que debe beber mucha agua y descansar. Carlos va a quedarse en casa dos días y espera mejorar pronto.",
    "text_en": "Carlos woke up with a headache and a sore throat. He has a fever, so he went to the doctor. The doctor prescribed a medicine and said he should drink a lot of water and rest. Carlos is going to stay home for two days and hopes to get better soon.",
    "text_ar": "استيقظ كارلوس وهو يعاني من صداع والتهاب في الحلق. إنه يعاني من حمى، لذا ذهب إلى الطبيب. وصف له الطبيب دواءً وقال إنه يجب أن يشرب الكثير من الماء ويستريح. سيبقى كارلوس في المنزل لمدة يومين ويأمل أن يتحسن سريعًا."
  },

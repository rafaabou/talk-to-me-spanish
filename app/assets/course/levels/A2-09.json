  "grammar": [
    {
      "title": {
        "es": "Imperativo Afirmativo (tú)",
        "en": "Affirmative Imperative (tú)",
        "ar": "صيغة الأمر المثبتة (مع tú)"
      },
      "explanation": {
        "es": "El imperativo para 'tú' usa las formas de tercera persona: habla (speak), come (eat), abre (open), escribe (write). Lo usamos para dar órdenes, peticiones y consejos: 'Habla más despacio, por favor.' Verbos irregulares: ser (sé), estar (está), ir (ve), venir (ven), dar (da).",
        "en": "The imperative for 'tú' uses third-person singular forms: habla (speak), come (eat), abre (open), escribe (write). We use it to give orders, requests and advice: 'Habla más despacio, por favor.' Irregular verbs: ser (sé), estar (está), ir (ve), venir (ven), dar (da).",
        "ar": "صيغة الأمر مع 'tú' تستخدم صيغ الغائب المفرد: habla (تكلّم)، come (كُل)، abre (افتح)، escribe (اكتب). نستخدمها لإعطاء الأوامر والطلبات والنصائح: 'Habla más despacio, por favor.' (تكلّم ببطء من فضلك.) أفعال شاذة: ser (sé)، estar (está)، ir (ve)، venir (ven)، dar (da)."
      },
      "examples": [
        {
          "es": "Habla más despacio, por favor.",
          "en": "Speak more slowly, please.",
          "ar": "تكلّم ببطء أكثر، من فضلك."
        },
        {
          "es": "Abre la ventana, hace calor aquí.",
          "en": "Open the window, it is hot here.",
          "ar": "افتح النافذة، الجو حار هنا."
        },
        {
          "es": "¡Ven aquí ahora!",
          "en": "Come here now!",
          "ar": "تعال إلى هنا الآن!"
        }
      ]
    },
    {
      "title": {
        "es": "Imperativo Negativo y Consejos",
        "en": "Negative Imperative and Advice",
        "ar": "صيغة الأمر المنفية والنصائح"
      },
      "explanation": {
        "es": "El imperativo negativo usa 'no + verbo en subjuntivo': 'No fumes aquí' (Don't smoke here), 'No salgas solo' (Don't go out alone). También usamos el imperativo para dar consejos: 'Come bien', 'Descansa', 'Bebe agua'.",
        "en": "The negative imperative uses 'no + subjunctive': 'No fumes aquí' (Don't smoke here), 'No salgas solo' (Don't go out alone). We also use it to give advice: 'Come bien' (Eat well), 'Descansa' (Rest), 'Bebe agua' (Drink water).",
        "ar": "صيغة الأمر المنفية تستخدم 'no + المضارع المنصوب': 'No fumes aquí' (لا تدخن هنا)، 'No salgas solo' (لا تخرج وحدك). ونستخدم الأمر أيضًا للنصيحة: 'Come bien' (كُل جيدًا)، 'Descansa' (استرح)، 'Bebe agua' (اشرب الماء)."
      },
      "examples": [
        {
          "es": "No hables alto en el hospital.",
          "en": "Do not speak loudly at the hospital.",
          "ar": "لا تتحدث بصوت عالٍ في المستشفى."
        },
        {
          "es": "No cierres la puerta ahora.",
          "en": "Do not close the door now.",
          "ar": "لا تغلق الباب الآن."
        },
        {
          "es": "Descansa un poco, estás cansado.",
          "en": "Rest a little, you are tired.",
          "ar": "استرح قليلًا، أنت متعب."
        }
      ]
    }
  ],
  "dialogue": {

  "grammar": [
    {
      "title": {
        "es": "Las Vocales del Español",
        "en": "Spanish Vowels",
        "ar": "حركات العلة في البرتغالية"
      },
      "explanation": {
        "es": "El español tiene 5 letras vocálicas (A, E, I, O, U). Hay vocales abiertas (a, e, o) y cerradas (i, u). La pronunciación de las vocales es muy clara y estable.",
        "en": "Spanish has 5 vowel letters (A, E, I, O, U). There are open vowels (a, e, o) and closed vowels (i, u). Vowel pronunciation is very clear and stable.",
        "ar": "تحتوي البرتغالية على 5 حروف علّة (A, E, I, O, U) لكن أصواتًا أكثر: حركات مفتوحة (é, ó) ومغلقة (ê, ô) وأنفية (ã, õ). تنتج الحركات الأنفية مع خروج الهواء من الأنف."
      },
      "examples": [
        {
          "es": "La E se pronuncia como en 'perro' (dog).",
          "en": "É is open as in 'pé' (foot).",
          "ar": "É حركة مفتوحة كما في 'pé' (قدم)."
        },
        {
          "es": "La O se pronuncia como en 'oso' (bear).",
          "en": "Ê is closed as in 'mês' (month).",
          "ar": "Ê حركة مغلقة كما في 'mês' (شهر)."
        },
        {
          "es": "La A se pronuncia como en 'casa' (house).",
          "en": "Ã is nasal as in 'mãe' (mother).",
          "ar": "Ã حركة أنفية كما في 'mãe' (أم)."
        }
      ],
      "en": "Spanish has 5 vowel letters (A, E, I, O, U). There are open vowels (a, e, o) and closed vowels (i, u). Vowel pronunciation is very clear and stable."
    },
    {
      "title": {
        "es": "Los Sonidos de la Lengua",
        "en": "Nasal Sounds",
        "ar": "الأصوات الأنفية"
      },
      "explanation": {
        "es": "En español, la Ñ es un sonido especial que se pronuncia con la lengua tocando el paladar. Ejemplos: 'año' (year), 'niño' (child), 'mañana' (morning).",
        "en": "Nasal sounds are marked by ~ (tilde) or by m and n at the end of a syllable. Examples: 'pão' (bread), 'sim' (yes), 'bem' (well). Air escapes through both nose and mouth at the same time.",
        "ar": "تُميّز الأصوات الأنفية بعلامة ~ (tilde) أو بالحرفين m و n في نهاية المقطع. أمثلة: 'pão' (خبز)، 'sim' (نعم)، 'bem' (حسنًا). يخرج الهواء من الأنف والفم معًا في نفس الوقت."
      },
      "examples": [
        {
          "es": "pan - bread",
          "en": "pão - bread",
          "ar": "pão - خبز"
        },
        {
          "es": "sí - yes",
          "en": "sim - yes",
          "ar": "sim - نعم"
        },
        {
          "es": "bien - well",
          "en": "bem - well",
          "ar": "bem - حسنًا"
        }
      ]
    }
  ],

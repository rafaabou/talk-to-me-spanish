  "grammar": [
    {
      "title": {
        "es": "Posesivos",
        "en": "Possessives",
        "ar": "ضمائر الملكية"
      },
      "explanation": {
        "es": "Posesivos: mi (my), tu/su (your), nuestro/nuestra (our), su (their). Concuerdan en género con el sustantivo: mi padre, mi madre, nuestro coche, nuestra casa.",
        "en": "Possessives: mi (my), tu/su (your), nuestro/nuestra (our), su (their). They agree in gender with the noun: mi padre (my father), mi madre (my mother), nuestro coche (our car), nuestra casa (our house).",
        "ar": "ضمائر الملكية: mi (ملكي)، tu/su (ملكك)، nuestro/nuestra (ملكنا)، su (ملكهم). تتطابق في الجنس مع الاسم: mi padre (أبي)، mi madre (أمي)، nuestro coche (سيارتنا)، nuestra casa (منزلنا)."
      },
      "examples": [
        {
          "es": "Mi madre es médica.",
          "en": "My mother is a doctor.",
          "ar": "أمي طبيبة."
        },
        {
          "es": "Su hermano estudia aquí.",
          "en": "Your/his brother studies here.",
          "ar": "أخوك يدرس هنا."
        },
        {
          "es": "Nuestra familia es grande.",
          "en": "Our family is big.",
          "ar": "عائلتنا كبيرة."
        }
      ]
    },
    {
      "title": {
        "es": "Describiendo Personas",
        "en": "Describing People",
        "ar": "وصف الأشخاص"
      },
      "explanation": {
        "es": "Para describir personas usamos ser + adjetivo: Él es alto, ella es simpática. Para la edad: Él tiene 40 años. Para características físicas: pelo (hair), ojos (eyes), alto/bajo (tall/short).",
        "en": "To describe people we use ser + adjective: Ele é alto (He is tall), ela é simpática (She is friendly). For age: Ele tem 40 anos (He is 40). For physical features: cabelo (hair), olhos (eyes), alto/baixo (tall/short).",
        "ar": "لوصف الأشخاص نستخدم ser + صفة: Ele é alto (هو طويل)، ela é simpática (هي ودودة). للعمر: Ele tem 40 anos (عمره 40). للصفات الجسدية: cabelo (شعر)، olhos (عيون)، alto/baixo (طويل/قصير)."
      },
      "examples": [
        {
          "es": "Mi abuelo tiene ochenta años.",
          "en": "My grandfather is eighty years old.",
          "ar": "جدي عمره ثمانون عامًا."
        },
        {
          "es": "Mi hermana es baja y simpática.",
          "en": "My sister is short and friendly.",
          "ar": "أختي قصيرة وودودة."
        },
        {
          "es": "El tío Pablo tiene el pelo corto.",
          "en": "Uncle Paulo has short hair.",
          "ar": "العم باولو لديه شعر قصير."
        }
      ]
    }
  ],
  "dialogue": {
    "title": {
      "es": "La Familia de Lucas",
      "en": "Lucas's Family",
      "ar": "عائلة لوكاس"
    },
    "lines": [
      {
        "speaker": "Ana",
        "es": "Lucas, cuéntame sobre tu familia.",
        "en": "Lucas, tell me about your family.",
        "ar": "لوكاس، حدثني عن عائلتك."
      },
      {
        "speaker": "Lucas",
        "es": "Mi padre es ingeniero y mi madre es profesora.",
        "en": "My father is an engineer and my mother is a teacher.",
        "ar": "أبي مهندس وأمي معلمة."
      },
      {
        "speaker": "Ana",
        "es": "¿Tienes hermanos?",
        "en": "Do you have siblings?",
        "ar": "هل لديك إخوة؟"
      },
      {
        "speaker": "Lucas",
        "es": "Sí, tengo una hermana menor. Tiene quince años.",
        "en": "Yes, I have a younger sister. She is fifteen.",
        "ar": "نعم، لدي أخت أصغر. عمرها خمسة عشر عامًا."
      },
      {
        "speaker": "Ana",
        "es": "¿Y tus abuelos?",
        "en": "And your grandparents?",
        "ar": "وأجدادك؟"
      },
      {
        "speaker": "Lucas",
        "es": "Mis abuelos viven con nosotros. Son muy queridos.",
        "en": "My grandparents live with us. They are very dear.",
        "ar": "يعيش أجدادي معنا. إنهم عزيزون جدًا."
      }
    ]
  },
  "reading": {
    "title": {
      "es": "Familia Hispana",
      "en": "Brazilian Family",
      "ar": "عائلة برازيلية"
    },
    "text_es": "La familia de Juan es grande. Su padre es médico y su madre es dentista. Juan tiene dos hermanos y una hermana. Los abuelos viven en otra ciudad. Los domingos, toda la familia se reúne para almorzar. Son muy unidos.",
    "text_en": "João's family is big. His father is a doctor and his mother is a dentist. João has two brothers and one sister. The grandparents live in another city. On Sundays, the whole family gathers for lunch. They are very close.",
    "text_ar": "عائلة جواو كبيرة. والده طبيب ووالدته طبيبة أسنان. لدى جواو شقيقان وأخت واحدة. يعيش الجدّان في مدينة أخرى. في أيام الأحد، تجتمع العائلة كلها لتناول الغداء. إنهم متحابون جدًا."
  },

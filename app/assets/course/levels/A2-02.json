  "grammar": [
    {
      "title": {
        "es": "Preguntando Precios",
        "en": "Asking Prices",
        "ar": "السؤال عن الأسعار"
      },
      "explanation": {
        "es": "Para preguntar el precio: '¿Cuánto cuesta?' (How much does it cost?), '¿Cuánto es?' (How much is it?) o '¿Cuál es el precio?' Respuestas: 'Cuesta veinte euros.', 'Es muy caro.', 'Es barato.'",
        "en": "To ask the price: 'Quanto custa?' (How much does it cost?), 'Quanto é?' (How much is it?) or 'Qual é o preço?' (What is the price?) Answers: 'Custa vinte reais.' (It costs twenty reais), 'É muito caro.' (It is very expensive), 'É barato.' (It is cheap).",
        "ar": "للسؤال عن السعر: 'Quanto custa?' (كم يكلف؟)، 'Quanto é?' (كم ثمنه؟) أو 'Qual é o preço?' (ما السعر؟) الإجابات: 'Custa vinte reais.' (يكلف عشرين ريالًا)، 'É muito caro.' (إنه غالٍ جدًا)، 'É barato.' (إنه رخيص)."
      },
      "examples": [
        {
          "es": "¿Cuánto cuesta esta camisa?",
          "en": "How much does this shirt cost?",
          "ar": "كم يكلف هذا القميص؟"
        },
        {
          "es": "Cuesta cincuenta euros.",
          "en": "It costs fifty reais.",
          "ar": "يكلف خمسين ريالًا."
        },
        {
          "es": "¡El precio es bueno!",
          "en": "The price is good!",
          "ar": "السعر جيد!"
        }
      ]
    },
    {
      "title": {
        "es": "Pagando en la Tienda",
        "en": "Paying at the Store",
        "ar": "الدفع في المتجر"
      },
      "explanation": {
        "es": "Para pagar: '¿Acepta tarjeta?' (Do you accept card?), '¿Puedo pagar en efectivo?' (Can I pay in cash?), '¿Al contado o a plazos?' (Cash or in installments?) '¿Tiene cambio?' (Do you have change?)",
        "en": "To pay: '¿Acepta tarjeta?' (Do you accept card?), '¿Puedo pagar en efectivo?' (Can I pay in cash?), '¿Al contado o a plazos?' (Cash or installments?) '¿Tiene cambio?' (Do you have change?)",
        "ar": "للدفع: '¿Acepta tarjeta؟' (هل تقبلون البطاقة؟)، '¿Puedo pagar en efectivo؟' (هل يمكنني الدفع نقدًا؟)، '¿Al contado o a plazos؟' (نقدًا أم بالتقسيط؟) '¿Tiene cambio؟' (هل لديك فكة؟)"
      },
      "examples": [
        {
          "es": "¿Puedo pagar con tarjeta de crédito?",
          "en": "Can I pay with a credit card?",
          "ar": "هل يمكنني الدفع ببطاقة الائتمان؟"
        },
        {
          "es": "Aceptamos efectivo y tarjeta.",
          "en": "We accept cash and card.",
          "ar": "نقبل النقد والبطاقة."
        },
        {
          "es": "El vendedor dio el cambio.",
          "en": "The salesperson gave the change.",
          "ar": "أعطى البائع الباقي."
        }
      ]
    }
  ],
  "dialogue": {
    "title": {
      "es": "En la Tienda de Ropa",
      "en": "At the Clothing Store",
      "ar": "في متجر الملابس"
    },
    "lines": [
      {
        "speaker": "Vendedor",
        "es": "¡Buenos días! ¿Quiere probarse esta camisa?",
        "en": "Good morning! Would you like to try on this shirt?",
        "ar": "صباح الخير! هل تريد تجربة هذا القميص؟"
      },
      {
        "speaker": "Cliente",
        "es": "Sí. ¿Cuánto cuesta?",
        "en": "Yes. How much does it cost?",
        "ar": "نعم. كم سعره؟"
      },
      {
        "speaker": "Vendedor",
        "es": "Cuesta ochenta euros, pero está en oferta: sesenta.",
        "en": "It costs eighty reais, but it is on sale: sixty.",
        "ar": "سعره ثمانون ريالًا، لكنه في تخفيض: ستون."
      },
      {
        "speaker": "Cliente",
        "es": "¡Qué bien! ¿Cuál es el descuento?",
        "en": "Great! What is the discount?",
        "ar": "رائع! ما الخصم؟"
      },
      {
        "speaker": "Vendedor",
        "es": "Veinte por ciento. ¿Acepta tarjeta?",
        "en": "Twenty percent. Do you accept card?",
        "ar": "عشرون بالمئة. هل تقبل البطاقة؟"
      },
      {
        "speaker": "Cliente",
        "es": "Sí, acepto. ¡Gracias!",
        "en": "Yes, I do. Thank you!",
        "ar": "نعم، أقبل. شكرًا!"
      }
    ]
  },
  "reading": {
    "title": {
      "es": "Compras en el Supermercado",
      "en": "Shopping at the Supermarket",
      "ar": "التسوق في السوبرماركت"
    },
    "text_es": "El sábado, Marina fue al supermercado a hacer compras. Compró frutas, pan y leche. Había una oferta de café, así que compró dos paquetes. En la caja, pagó con tarjeta y recibió el cambio en la aplicación.",
    "text_en": "On Saturday, Marina went to the supermarket to go shopping. She bought fruits, bread and milk. There was a sale on coffee, so she bought two packages. At the checkout, she paid with her card and got the change in the app.",
    "text_ar": "يوم السبت، ذهبت مارينا إلى السوبرماركت للتسوق. اشترت فواكه وخبزًا وحليبًا. كان هناك تخفيض على القهوة، فاشترت علبتين. عند الصندوق، دفعت بالبطاقة واستلمت الباقي عبر التطبيق."
  },

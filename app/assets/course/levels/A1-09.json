    },
    "lines": [
      {
        "speaker": "Camarero",
        "es": "¡Buenas noches! Aquí está el menú.",
        "en": "Good evening! Here is the menu.",
        "ar": "مساء الخير! هذه قائمة الطعام."
      },
      {
        "speaker": "Cliente",
        "es": "Gracias. ¿Qué recomienda?",
        "en": "Thank you. What do you recommend?",
        "ar": "شكرًا. ماذا تنصح؟"
      },
      {
        "speaker": "Camarero",
        "es": "El pescado con arroz es delicioso.",
        "en": "The fish with rice is delicious.",
        "ar": "السمك مع الأرز لذيذ."
      },
      {
        "speaker": "Cliente",
        "es": "Entonces me gustaría el pescado y un agua, por favor.",
        "en": "Then I'd like the fish and a water, please.",
        "ar": "إذن أود السمك والماء، من فضلك."
      },
      {
        "speaker": "Camarero",
        "es": "¡Muy bien! ¿Algún postre?",
        "en": "Very well! Any dessert?",
        "ar": "ممتاز! أي حلوى؟"
      },
      {
        "speaker": "Cliente",
        "es": "Un café y la cuenta, por favor.",
        "en": "A coffee and the bill, please.",
        "ar": "قهوة والحساب، من فضلك."
      }
    ]
  },
  "reading": {
    "title": {
      "es": "Un Almuerzo Hispano",
      "en": "A Brazilian Lunch",
      "ar": "غداء برازيلي"
    },
    "text_es": "En España, el almuerzo es una comida importante. Muchas personas comen arroz, frijoles, carne o pollo y ensalada. El zumo de naranja es muy popular. Al final, un cafecito. La propina en el restaurante es opcional.",
    "text_en": "In Spain, lunch is an important meal. Many people eat rice, beans, meat or chicken and salad. Orange juice is very popular. At the end, a small coffee. Restaurant tipping is optional.",
    "text_ar": "في إسبانيا، الغداء وجبة مهمة. يأكل كثيرون الأرز والفاصوليا واللحم أو الدجاج والسلطة. عصير البرتقال شائع جدًا. وفي النهاية قهوة صغيرة. والإكرامية في المطعم اختيارية."
  },

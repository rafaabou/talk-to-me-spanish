  "grammar": [
    {
      "title": {
        "es": "Pidiendo en el Restaurante",
        "en": "Ordering at a Restaurant",
        "ar": "الطلب في المطعم"
      },
      "explanation": {
        "es": "Para pedir, usamos 'quiero' (I want) o, más educado, 'me gustaría' (I would like). Ejemplo: 'Me gustaría un zumo de naranja, por favor.' El camarero pregunta: '¿Qué va a tomar?' (What will you have?)",
        "en": "To order, we use 'quiero' (I want) or, more polite, 'me gustaría' (I would like). Example: 'Me gustaría un zumo de naranja, por favor.' The waiter asks: '¿Qué va a tomar?'",
        "ar": "للطلب نستخدم 'quiero' (أريد) أو بصيغة أكثر تهذيبًا 'me gustaría' (أود). مثال: 'Me gustaría un zumo de naranja, por favor.' يسأل النادل: '¿Qué va a tomar؟'"
      },
      "examples": [
        {
          "es": "Quiero un plato de feijoada.",
          "en": "I want a feijoada dish.",
          "ar": "أريد طبقًا من فيجوعادا."
        },
        {
          "es": "Me gustaría una ensalada, por favor.",
          "en": "I would like a salad, please.",
          "ar": "أود سلطة، من فضلك."
        },
        {
          "es": "¿Qué va a tomar?",
          "en": "What will you have?",
          "ar": "ماذا ستطلب؟"
        }
      ]
    },
    {
      "title": {
        "es": "La Cuenta",
        "en": "The Bill",
        "ar": "الحساب"
      },
      "explanation": {
        "es": "Para pedir la cuenta: '¡La cuenta, por favor!' o '¿Puede traer la cuenta?'. El pago: '¿Acepta tarjeta?' (Do you accept card?). Respuesta: 'Sí, aceptamos.' La propina (tip) es opcional y generalmente el 10%.",
        "en": "To ask for the bill: '¡La cuenta, por favor!' or '¿Puede traer la cuenta?'. Payment: '¿Acepta tarjeta?' (Do you accept card?). Answer: 'Sí, aceptamos.' Tipping is optional and usually 10%.",
        "ar": "لطلب الحساب: '¡La cuenta, por favor!' أو '¿Puede traer la cuenta؟'. الدفع: '¿Acepta tarjeta؟' (هل تقبلون البطاقة؟). الجواب: 'Sí, aceptamos.' الإكرامية اختيارية وعادةً 10%."
      },
      "examples": [
        {
          "es": "¡La cuenta, por favor!",
          "en": "The bill, please!",
          "ar": "الحساب من فضلك!"
        },
        {
          "es": "¿Acepta tarjeta?",
          "en": "Do you accept card?",
          "ar": "هل تقبل البطاقة؟"
        },
        {
          "es": "¿Está incluida la propina?",
          "en": "Is the tip included?",
          "ar": "هل الإكرامية مشمولة؟"
        }
      ]
    }
  ],
  "dialogue": {
    "title": {
      "es": "En el Restaurante",

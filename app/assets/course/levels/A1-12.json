  "grammar": [
    {
      "title": {
        "es": "Revisión de Gramática",
        "en": "Grammar Review",
        "ar": "مراجعة القواعد"
      },
      "explanation": {
        "es": "En el nivel A1 aprendimos: ser y estar (Yo soy español, Yo estoy cansado), verbos regulares en presente (hablo, como, abro), artículos (el, la, los, las), posesivos (mi, tu, su), preposiciones (en), números y la hora, y el vocabulario esencial para presentarse y sobrevivir en situaciones básicas.",
        "en": "At level A1 we learned: ser and estar (Yo soy español - I am Spanish, Yo estoy cansado - I am tired), regular present-tense verbs (hablo, como, abro), articles (el, la, los, las), possessives (mi, tu, su), prepositions (en), numbers and time, and essential vocabulary to introduce yourself and handle basic situations.",
        "ar": "في المستوى A1 تعلمنا: ser و estar (yo soy español - أنا إسباني، yo estoy cansado - أنا متعب)، الأفعال المنتظمة في المضارع (hablo، como، abro)، أدوات التعريف (el، la، los، las)، ضمائر الملكية (mi، tu، su)، حرف الجر (en)، الأرقام والوقت، والمفردات الأساسية لتقديم نفسك والتعامل مع المواقف البسيطة."
      },
      "examples": [
        {
          "es": "Yo soy español y estoy feliz.",
          "en": "I am Brazilian and I am happy.",
          "ar": "أنا برازيلي وأنا سعيد."
        },
        {
          "es": "Mi familia come a las ocho.",
          "en": "My family eats at eight o'clock.",
          "ar": "تأكل عائلتي في الساعة الثامنة."
        },
        {
          "es": "El libro está en la mesa, al lado del bolígrafo.",
          "en": "The book is on the table, next to the pen.",
          "ar": "الكتاب على الطاولة، بجانب القلم."
        }
      ]
    }
  ],
  "dialogue": {
    "title": {
      "es": "Conversación Completa",
      "en": "Complete Conversation",
      "ar": "محادثة كاملة"
    },
    "lines": [
      {
        "speaker": "Visitante",
        "es": "¡Hola! Mi nombre es Karim. Soy de Egipto.",
        "en": "Hello! My name is Karim. I'm from Egypt.",
        "ar": "مرحبًا! اسمي كريم. أنا من مصر."
      },
      {
        "speaker": "Marina",
        "es": "¡Mucho gusto, Karim! Yo soy Marina.",
        "en": "Nice to meet you, Karim! I'm Marina.",
        "ar": "سررت بلقائك يا كريم! أنا مارينا."
      },
      {
        "speaker": "Visitante",
        "es": "¿Qué hora es?",
        "en": "What time is it?",
        "ar": "كم الساعة؟"
      },
      {
        "speaker": "Marina",
        "es": "Son las diez. ¿Quieres un café?",
        "en": "It's ten o'clock. Would you like a coffee?",
        "ar": "إنها العاشرة. هل تريد قهوة؟"
      },
      {
        "speaker": "Visitante",
        "es": "Sí, gracias. Me gustaría un café con leche.",
        "en": "Yes, thank you. I would like a coffee with milk.",
        "ar": "نعم، شكرًا. أود قهوة بالحليب."
      },
      {
        "speaker": "Marina",
        "es": "Aquí tiene. ¡Buen provecho!",
        "en": "Here you go. Enjoy!",
        "ar": "تفضل. بالهناء والشفاء!"
      }
    ]
  },
  "reading": {
    "title": {
      "es": "Conociendo a Karim",
      "en": "Getting to Know Karim",
      "ar": "التعرف على كريم"
    },
    "text_es": "Karim es de Egipto y ahora vive en España. Habla árabe, inglés y aprende español. Todos los días estudia en la escuela de idiomas. Su familia vive en El Cairo. Él es alto, simpático y muy inteligente. Hoy está feliz porque es su cumpleaños.",
    "text_en": "Karim is from Egypt and now lives in Spain. He speaks Arabic and English and is learning Spanish. Every day he studies at the language school. His family lives in Cairo. He is tall, friendly and very intelligent. Today he is happy because it's his birthday.",
    "text_ar": "كريم من مصر ويعيش الآن في إسبانيا. يتحدث العربية والإنجليزية ويتعلم الإسبانية. كل يوم يدرس في مدرسة اللغات. تعيش عائلته في القاهرة. هو طويل وودود وذكي جدًا. اليوم هو سعيد لأنه عيد ميلاده."
  },

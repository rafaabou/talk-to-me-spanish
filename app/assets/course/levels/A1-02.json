  "grammar": [
    {
      "title": {
        "es": "Formal e Informal",
        "en": "Formal and Informal",
        "ar": "رسمي وغير رسمي"
      },
      "explanation": {
        "es": "En español, 'tú' es la forma común de tratamiento. En algunas regiones se usa 'vos'. El tratamiento formal usa 'usted'. Los saludos también varían: 'hola' (informal), 'buenos días' (cortés), 'qué tal' (neutro).",
        "en": "In Spanish, 'tú' is the common form of address. In some regions 'vos' is used. Formal address uses 'usted'. Greetings also vary: 'hola' (informal), 'buenos días' (polite), 'qué tal' (neutral).",
        "ar": "في الإسبانية، 'tú' هي صيغة الخطاب الشائعة. وفي بعض المناطق تُستخدم 'vos'. أما الخطاب الرسمي فيستخدم 'usted'. وتختلف التحيات أيضًا: 'hola' (غير رسمية)، 'buenos días' (مهذبة)، 'qué tal' (محايدة)."
      },
      "examples": [
        {
          "es": "Hola, ¿todo bien? (informal)",
          "en": "Hi, how's it going? (informal)",
          "ar": "مرحبًا، كيف الحال؟ (غير رسمي)"
        },
        {
          "es": "Buenos días, señor Silva. (formal)",
          "en": "Good morning, Mr. Silva. (formal)",
          "ar": "صباح الخير، سيد سيلفا. (رسمي)"
        },
        {
          "es": "Gracias, de nada. (femenino)",
          "en": "Thank you, you're welcome. (feminine)",
          "ar": "شكرًا، عفوًا. (مؤنث)"
        }
      ]
    },
    {
      "title": {
        "es": "Presentándose",
        "en": "Introducing Yourself",
        "ar": "تقديم نفسك"
      },
      "explanation": {
        "es": "Para presentarse: 'Me llamo...' o 'Mi nombre es...'. Después: 'Mucho gusto' (nice to meet you). Para preguntar: '¿Cómo te llamas?'",
        "en": "To introduce yourself: 'Me llamo...' (My name is...) or 'Mi nombre es...'. Then: 'Mucho gusto' (Nice to meet you). To ask: '¿Cómo te llamas?'",
        "ar": "لتقديم نفسك: 'Me llamo...' أو 'Mi nombre es...'. ثم: 'Mucho gusto' (سررت بلقائك). للسؤال: '¿Cómo te llamas؟'"
      },
      "examples": [
        {
          "es": "Mi nombre es Ana.",
          "en": "My name is Ana.",
          "ar": "اسمي آنا."
        },
        {
          "es": "¡Mucho gusto! Me llamo Carlos.",
          "en": "Nice to meet you! My name is Carlos.",
          "ar": "سررت بلقائك! اسمي كارلوس."
        },
        {
          "es": "¿Cuál es tu nombre?",
          "en": "What's your name?",
          "ar": "ما اسمك؟"
        }
      ]
    }
  ],
  "dialogue": {
    "title": {
      "es": "Conociendo a Alguien",
      "en": "Meeting Someone",
      "ar": "التعرف على شخص"
    },
    "lines": [
      {
        "speaker": "Ana",
        "es": "¡Hola! Mi nombre es Ana. ¿Y tú?",
        "en": "Hello! My name is Ana. And you?",
        "ar": "مرحبًا! اسمي آنا. وأنت؟"
      },
      {
        "speaker": "Pedro",
        "es": "¡Hola, Ana! Yo soy Pedro. Mucho gusto.",
        "en": "Hi, Ana! I'm Pedro. Nice to meet you.",
        "ar": "مرحبًا آنا! أنا بيدرو. سررت بلقائك."
      },
      {
        "speaker": "Ana",
        "es": "El gusto es mío. ¿Cómo estás?",
        "en": "The pleasure is mine. How are you?",
        "ar": "بسرور. كيف حالك؟"
      },
      {
        "speaker": "Pedro",
        "es": "¡Todo bien, gracias! ¿Y tú?",
        "en": "I'm fine, thanks! And you?",
        "ar": "أنا بخير، شكرًا! وأنت؟"
      },
      {
        "speaker": "Ana",
        "es": "¡Todo genial. Hasta luego, Pedro!",
        "en": "Everything great. See you later, Pedro!",
        "ar": "كل شيء رائع. أراك لاحقًا يا بيدرو!"
      },
      {
        "speaker": "Pedro",
        "es": "¡Chao, Ana! Hasta mañana.",
        "en": "Bye, Ana! See you tomorrow.",
        "ar": "وداعًا آنا! أراك غدًا."
      }
    ]
  },
  "reading": {
    "title": {
      "es": "Saludos en Español",
      "en": "Greetings in Spanish",
      "ar": "التحيات في الإسبانية"
    },
    "text_es": "En Latinoamérica, las personas se saludan con un beso o un apretón de manos. 'Hola' es un saludo común. Por la mañana decimos 'buenos días'. Por la tarde, 'buenas tardes'. Por la noche, 'buenas noches'. Cuando llegamos preguntamos '¿todo bien?'.",
    "text_en": "In Latin America, people greet each other with a kiss or a handshake. 'Hola' is a common greeting. In the morning we say 'buenos días'. In the afternoon, 'buenas tardes'. At night, 'buenas noches'. When we arrive we ask '¿todo bien?'.",
    "text_ar": "في أمريكا اللاتينية، يتحيي الناس بقبلة أو مصافحة. 'Hola' تحية شائعة. في الصباح نقول 'buenos días'. وبعد الظهر 'buenas tardes'. وفي الليل 'buenas noches'. وعند اللقاء نسأل '¿todo bien؟'."
  },

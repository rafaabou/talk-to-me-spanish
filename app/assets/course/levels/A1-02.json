  "grammar": [
    {
      "title": {
        "es": "Formal e Informal",
        "en": "Formal and Informal",
        "ar": "رسمي وغير رسمي"
      },
      "explanation": {
        "es": "En español, 'tú' es la forma común de tratamiento. En algunas regiones se usa 'vos'. El tratamiento formal usa 'usted'. Los saludos también varían: 'hola' (informal), 'buenos días' (cortés), 'qué tal' (neutro).",
        "en": "In Brazil, 'você' is the common form of address. 'Tu' is used in some regions. Formal address uses 'o senhor' (sir) and 'a senhora' (madam). Greetings also vary: 'oi' (informal), 'olá' (neutral), 'bom dia' (polite).",
        "ar": "في البرازيل، 'você' هي صيغة الخطاب الشائعة. تُستخدم 'tu' في بعض المناطق. الخطاب الرسمي يستخدم 'o senhor' (سيدي) و 'a senhora' (سيدتي). تختلف التحيات أيضًا: 'oi' (غير رسمي)، 'olá' (محايد)، 'bom dia' (مهذب)."
      },
      "examples": [
        {
          "es": "Hola, ¿todo bien? (informal)",
          "en": "Hi, how's it going? (informal)",
          "ar": "مرحبًا، كيف الحال؟ (غير رسمي)"
        },
        {
          "es": "Buenos días, señor Silva. (formal)",
          "en": "Good morning, Mr. Silva. (formal)",
          "ar": "صباح الخير، سيد سيلفا. (رسمي)"
        },
        {
          "es": "Gracias, de nada. (femenino)",
          "en": "Thank you, you're welcome. (feminine)",
          "ar": "شكرًا، عفوًا. (مؤنث)"
        }
      ]
    },
    {
      "title": {
        "es": "Presentándose",
        "en": "Introducing Yourself",
        "ar": "تقديم نفسك"
      },
      "explanation": {
        "es": "Para presentarse: 'Me llamo...' o 'Mi nombre es...'. Después: 'Mucho gusto' (nice to meet you). Para preguntar: '¿Cómo te llamas?'",
        "en": "To introduce yourself: 'Eu me chamo...' (I'm called...) or 'Meu nome é...' (My name is...). Then: 'Muito prazer' (Nice to meet you). To ask: 'Qual é o seu nome?' (What's your name?)",
        "ar": "لتقديم نفسك: 'Eu me chamo...' أو 'Meu nome é...'. ثم: 'Muito prazer' (سررت بلقائك). للسؤال: 'Qual é o seu nome?' (ما اسمك؟)"
      },
      "examples": [
        {
          "es": "Mi nombre es Ana.",
          "en": "My name is Ana.",
          "ar": "اسمي آنا."
        },
        {
          "es": "¡Mucho gusto! Me llamo Carlos.",
          "en": "Nice to meet you! My name is Carlos.",
          "ar": "سررت بلقائك! اسمي كارلوس."
        },
        {
          "es": "¿Cuál es tu nombre?",
          "en": "What's your name?",
          "ar": "ما اسمك؟"
        }
      ]
    }
  ],
  "dialogue": {
    "title": {
      "es": "Conociendo a Alguien",

  "grammar": [
    {
      "title": {
        "es": "Contestando el Teléfono",
        "en": "Answering the Phone",
        "ar": "الرد على الهاتف"
      },
      "explanation": {
        "es": "Al contestar: '¿Aló?' (Hello?), '¿Quién habla?' (Who is speaking?), '¿De parte de quién?' (Who is calling?). Para pedir a alguien: '¿Puedo hablar con Pedro?' Respuestas: 'Un momento, por favor', 'No está. ¿Puedo anotar un recado?'",
        "en": "When answering: '¿Aló?' (Hello?), '¿Quién habla?' (Who is speaking?), '¿De parte de quién?' (Who is calling?). To ask for someone: '¿Puedo hablar con Pedro?' Answers: 'Un momento, por favor', 'No está. ¿Puedo tomar un recado?'",
        "ar": "عند الرد: '¿Aló؟' (ألو؟)، '¿Quién habla؟' (من المتحدث؟)، '¿De parte de quién؟' (من المتصل؟). لطلب شخص ما: '¿Puedo hablar con Pedro؟' (هل يمكنني التحدث مع بيدرو؟). الإجابات: 'Un momento, por favor' (لحظة من فضلك)، 'No está. ¿Puedo tomar un recado؟' (ليس هنا. هل أسجل رسالة؟)"
      },
      "examples": [
        {
          "es": "¿Aló, con quién hablo?",
          "en": "Hello, who am I speaking with?",
          "ar": "ألو، مع من أتحدث؟"
        },
        {
          "es": "Un momento, por favor.",
          "en": "One moment, please.",
          "ar": "لحظة واحدة، من فضلك."
        },
        {
          "es": "No está. ¿Puede dejar un recado?",
          "en": "He is not here. Can you leave a message?",
          "ar": "إنه ليس هنا. هل يمكنك ترك رسالة؟"
        }
      ]
    },
    {
      "title": {
        "es": "Llamando y Usando el Móvil",
        "en": "Calling and Using the Cell Phone",
        "ar": "الاتصال واستخدام الهاتف المحمول"
      },
      "explanation": {
        "es": "Verbo 'llamar': 'llamar a + persona' (to call someone): 'Voy a llamar a mi madre.' '¡Llámame!' (Call me!) 'Colgar' (to hang up), 'marcar' (to dial), 'enviar un mensaje' (to send a message). 'El móvil está sin señal.'",
        "en": "Verb 'llamar': 'llamar a + person' (to call someone): 'Voy a llamar a mi madre.' (I will call my mother.) '¡Llámame!' (Call me!) 'Colgar' (to hang up), 'marcar' (to dial), 'enviar un mensaje' (to send a message). 'El móvil está sin señal.' (The cell phone has no signal.)",
        "ar": "الفعل 'llamar': 'llamar a + شخص' (الاتصال بشخص ما): 'Voy a llamar a mi madre.' (سأتصل بأمي). '¡Llámame!' (اتصل بي!) 'Colgar' (إنهاء المكالمة)، 'marcar' (طلب الرقم)، 'enviar un mensaje' (إرسال رسالة). 'El móvil está sin señal.' (لا توجد إشارة في الهاتف.)"
      },
      "examples": [
        {
          "es": "Te llamaré después del almuerzo.",
          "en": "I will call you after lunch.",
          "ar": "سأتصل بك بعد الغداء."
        },
        {
          "es": "Envíame un mensaje cuando llegues.",
          "en": "Send me a message when you arrive.",
          "ar": "أرسل لي رسالة عندما تصل."
        },
        {
          "es": "Su móvil está apagado.",
          "en": "His cell phone is off.",
          "ar": "هاتفه المحمول مغلق."
        }
      ]
    }
  ],
  "dialogue": {
    "title": {
      "es": "Una Llamada",
      "en": "A Phone Call",
      "ar": "مكالمة هاتفية"
    },
    "lines": [
      {
        "speaker": "Recepcionista",
        "es": "¿Aló, empresa Silva? ¡Buenos días!",
        "en": "Hello, Silva company. Good morning!",
        "ar": "ألو، شركة سيلفا. صباح الخير!"
      },
      {
        "speaker": "Cliente",
        "es": "¡Buenos días! ¿Con quién hablo?",
        "en": "Good morning! Who am I speaking with?",
        "ar": "صباح الخير! مع من أتحدث؟"
      },
      {
        "speaker": "Recepcionista",
        "es": "Habla con la secretaria.",
        "en": "You are speaking with the secretary.",
        "ar": "تتحدث مع السكرتيرة."
      },
      {
        "speaker": "Cliente",
        "es": "¿Puedo hablar con el gerente, por favor?",
        "en": "Can I speak with the manager, please?",
        "ar": "هل يمكنني التحدث مع المدير، من فضلك؟"
      },
      {
        "speaker": "Recepcionista",
        "es": "Un momento. Está en una reunión.",
        "en": "One moment. He is in a meeting.",
        "ar": "لحظة واحدة. إنه في اجتماع."
      },
      {
        "speaker": "Cliente",
        "es": "¿Entonces puedo dejar un recado?",
        "en": "Then can I leave a message?",
        "ar": "إذن هل يمكنني ترك رسالة؟"
      }
    ]
  },
  "reading": {
    "title": {
      "es": "La Comunicación Hoy",
      "en": "Communication Today",
      "ar": "التواصل اليوم"
    },
    "text_es": "Hoy en día, la comunicación es rápida. Con el móvil, enviamos mensajes y hacemos videollamadas a cualquier hora. Si la persona no contesta, dejamos un recado en el buzón de voz. Para el trabajo, el correo electrónico sigue siendo muy importante, pero la llamada telefónica continúa siendo la forma más personal.",
    "text_en": "Nowadays, communication is fast. With the cell phone, we send messages and make video calls at any time. If the person does not answer, we leave a message on voicemail. For work, email is still very important, but the phone call remains the most personal way.",
    "text_ar": "في الوقت الحاضر، التواصل سريع. بالهاتف المحمول، نرسل الرسائل ونجري مكالمات الفيديو في أي وقت. إذا لم يردّ الشخص، نترك رسالة في البريد الصوتي. بالنسبة للعمل، ما زال البريد الإلكتروني مهمًا جدًا، لكن المكالمة الهاتفية تظل أكثر الطرق شخصية."
  },

  "grammar": [
    {
      "title": {
        "es": "Concordancia de Género",
        "en": "Gender Agreement",
        "ar": "مطابقة الجنس"
      },
      "explanation": {
        "es": "Los adjetivos concuerdan con el sustantivo en género y número: camisa roja, zapato rojo, camisas rojas. Los adjetivos terminados en -e o consonante no cambian: azul, verde, feliz.",
        "en": "Adjectives agree with the noun in gender and number: camisa vermelha (red shirt, f), sapato vermelho (red shoe, m), camisas vermelhas (red shirts, pl). Adjectives ending in -e or a consonant do not change: azul (blue), verde (green), feliz (happy).",
        "ar": "تتطابق الصفات مع الاسم في الجنس والعدد: camisa vermelha (قميص أحمر مؤنث)، sapato vermelho (حذاء أحمر مذكر)، camisas vermelhas (قمصان حمراء جمع). الصفات المنتهية بـ -e أو بحرف ساكن لا تتغير: azul (أزرق)، verde (أخضر)، feliz (سعيد)."
      },
      "examples": [
        {
          "es": "El vestido es bonito.",
          "en": "The dress is pretty.",
          "ar": "الفستان جميل."
        },
        {
          "es": "La camiseta es blanca.",
          "en": "The t-shirt is white.",
          "ar": "التيشيرت أبيض."
        },
        {
          "es": "Los zapatos son nuevos.",
          "en": "The shoes are new.",
          "ar": "الأحذية جديدة."
        }
      ]
    },
    {
      "title": {
        "es": "El Verbo Vestir",
        "en": "The Verb Vestir",
        "ar": "الفعل Vestir (يرتدي)"
      },
      "explanation": {
        "es": "Para decir lo que alguien lleva, usamos 'llevar' (to wear) o 'estar con' (to be with): Yo llevo una camisa (I wear a shirt), Estoy con una camisa azul (I'm wearing a blue shirt). 'Llevar' es más común.",
        "en": "To say what someone wears, we use 'llevar' (to wear) or 'estar con' (to be wearing): Llevo una camisa (I wear a shirt), Estoy con una camisa azul (I'm wearing a blue shirt). 'Llevar' is more common.",
        "ar": "للتعبير عمّا يرتديه الشخص، نستخدم 'llevar' (يرتدي) أو 'estar con' (يرتدي شيئًا): llevo una camisa (أرتدي قميصًا)، estoy con una camisa azul (أرتدي قميصًا أزرق). 'llevar' أكثر شيوعًا."
      },
      "examples": [
        {
          "es": "Estoy con una blusa rosa.",
          "en": "I'm wearing a pink blouse.",
          "ar": "أنا أرتدي بلوزة وردية."
        },
        {
          "es": "Él lleva un pantalón negro.",
          "en": "He wears black pants.",
          "ar": "يرتدي بنطالًا أسود."
        },
        {
          "es": "Ella está con un vestido azul.",
          "en": "She is wearing a blue dress.",
          "ar": "هي ترتدي فستانًا أزرق."
        }
      ]
    }
  ],
  "dialogue": {
    "title": {
      "es": "Comprando Ropa",
      "en": "Shopping for Clothes",
      "ar": "شراء الملابس"
    },
    "lines": [
      {
        "speaker": "Vendedora",
        "es": "¡Buenas tardes! ¿Puedo ayudarle?",
        "en": "Good afternoon! Can I help you?",
        "ar": "مساء الخير! هل يمكنني مساعدتك؟"
      },
      {
        "speaker": "Cliente",
        "es": "Quiero una camisa blanca, por favor.",
        "en": "I want a white shirt, please.",
        "ar": "أريد قميصًا أبيض، من فضلك."
      },
      {
        "speaker": "Vendedora",
        "es": "Tenemos esta camisa. Es muy bonita.",
        "en": "We have this shirt. It's very pretty.",
        "ar": "لدينا هذا القميص. إنه جميل جدًا."
      },
      {
        "speaker": "Cliente",
        "es": "¿Y el pantalón negro? ¿Está en oferta?",
        "en": "And the black pants? Are they on sale?",
        "ar": "والبنطال الأسود؟ هل هو في تخفيضات؟"
      },
      {
        "speaker": "Vendedora",
        "es": "Sí, cuesta noventa euros.",
        "en": "Yes, it costs ninety reais.",
        "ar": "نعم، سعره تسعون ريالًا."
      }
    ]

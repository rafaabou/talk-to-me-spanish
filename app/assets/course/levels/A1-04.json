  "grammar": [
    {
      "title": {
        "es": "Artículos Definidos",
        "en": "Definite Articles",
        "ar": "أدوات التعريف"
      },
      "explanation": {
        "es": "Los artículos definidos son: el (masculino singular), la (femenino singular), los (masculino plural), las (femenino plural). Ejemplos: el libro, la casa, los libros, las casas. La mayoría de los sustantivos terminados en -o son masculinos y en -a femeninos.",
        "en": "The definite articles are: o (masc. sing.), a (fem. sing.), os (masc. pl.), as (fem. pl.). Examples: o livro (the book), a casa (the house), os livros (the books), as casas (the houses). Most nouns ending in -o are masculine and -a are feminine.",
        "ar": "أدوات التعريف هي: o (مذكر مفرد)، a (مؤنث مفرد)، os (مذكر جمع)، as (مؤنث جمع). أمثلة: o livro (الكتاب)، a casa (المنزل)، os livros (الكتب)، as casas (المنازل). معظم الأسماء المنتهية بـ -o مذكر والمنتهية بـ -a مؤنث."
      },
      "examples": [
        {
          "es": "El libro está sobre la mesa.",
          "en": "The book is on the table.",
          "ar": "الكتاب على الطاولة."
        },
        {
          "es": "La profesora es muy buena.",
          "en": "The teacher is very good.",
          "ar": "المعلمة جيدة جدًا."
        },
        {
          "es": "Los alumnos estudian español.",
          "en": "The students study Spanish.",
          "ar": "يدرس الطلاب البرتغالية."
        }
      ],
      "en": "The students study Spanish."
    },
    {
      "title": {
        "es": "Formación del Plural",
        "en": "Forming the Plural",
        "ar": "تكوين الجمع"
      },
      "explanation": {
        "es": "Los sustantivos terminados en vocal forman el plural con -s: libro → libros, casa → casas. Terminados en -r o -z: profesor → profesores, lápiz → lápices. Terminados en -s: mes → meses.",
        "en": "Nouns ending in a vowel form the plural with -s: livro → livros (books), casa → casas (houses). Ending in -r or -s: professor → professores (teachers). Ending in -ão: cão → cães (dogs) (some: cidadão → cidadãos, pão → pães).",
        "ar": "الأسماء المنتهية بحرف علة تجمع بإضافة -s: livro → livros (كتب)، casa → casas (منازل). المنتهية بـ -r أو -s: professor → professores (معلمون). المنتهية بـ -ão: cão → cães (كلاب) (وبعضها: cidadão → cidadãos، pão → pães)."
      },
      "examples": [
        {
          "es": "Un libro → dos libros",
          "en": "One book → two books",
          "ar": "كتاب واحد → كتابان"
        },
        {
          "es": "Una casa → muchas casas",
          "en": "One house → many houses",
          "ar": "منزل واحد → منازل كثيرة"
        },
        {
          "es": "El pan → los panes",
          "en": "The bread → the breads",
          "ar": "الخبز → الأرغفة"
        }
      ]
    }
  ],

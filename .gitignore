# Root .gitignore for Talk To Me Monorepo

# =============================================================================
# DevSecOps / CI/CD Artifacts
# =============================================================================

# Security scanning reports
*security-report*.json
*grype-report*.json
*trivy-results*.sarif
*trivy-results*.json
*mobsf-report*.json
*codeql-results*.sarif
*analysis-report.json
*deps-outdated.json
*license-report*.json

# SBOM files
sbom*.cdx.json
sbom*.json

# Cosign signatures
*.sig
*.pem
*.key

# Provenance
provenance.intoto.jsonl

# Security scan reports
security-reports/
scan-reports/

# MobSF
mobsf_scan.log
mobsf_*.json

# Cosign
cosign.pub
cosign.key

# Keystore (never commit!)
*.keystore
*.jks
keystore.properties
release.keystore

# Signing
signingConfigs.gradle
keystore.properties

# Docker
.docker/
docker-compose.override.yml

# Environment files
.env
.env.local
.env.*.local
*.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
*.lcov
*.coverage

# Temporary
*.tmp
*.temp
tmp/
temp/
*.bak

# Python
__pycache__/
*.pyc

# Dependencies
node_modules/
.pub-cache/

# Generated
*.g.dart
*.freezed.dart
*.gr.dart

# Analysis
analysis-report.json

# Secrets (never commit!)
secrets.yaml
secrets.yml
*.secret

# =============================================================================
# Flutter/Dart/Pub related (both apps)
# =============================================================================

**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

